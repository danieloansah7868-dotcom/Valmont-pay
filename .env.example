# ═══════════════════════════════════════════════════════════════════════
# VALMONT-PAY — Multi-Tenant Payment Gateway Configuration
# ═══════════════════════════════════════════════════════════════════════

# ─── Paystack (global fallback) ────────────────────────────────────────
# Paystack secret key (test: sk_test_..., live: sk_live_...)
# Get yours from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OPTIONAL webhook HMAC secret ──────────────────────────────────────
# Paystack signs x-paystack-signature with PAYSTACK_SECRET_KEY, which is always
# authoritative when present. This is only a legacy local/custom-event fallback
# and never overrides the Paystack key.
# WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (REQUIRED for production) ────────────────────────────────
# Create a project at https://supabase.com and copy these from Settings → API.
SUPABASE_URL=https://xxxxxx.supabase.co
# PREFERRED. Trusted server-side writes that Row Level Security cannot reject.
# Never expose this in a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Fallback only when the transactions table has an RLS insert/select policy:
SUPABASE_ANON_KEY=eyJ...

# ─── Admin Dashboard Login ─────────────────────────────────────────────
# ADMIN_PASSWORD does double duty: it logs the operator into the admin
# pages AND authorizes the admin-guarded API endpoints (X-Admin-Key header).
# Without it, /api/admin/*, key rotation, manual transactions, webhook-debug
# POSTs and terminal-status order writes are OPEN TO THE INTERNET.
ADMIN_EMAIL=support@valmontpay.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# Optional dedicated HMAC key for vp_admin session cookies. Defaults to a
# SHA-256 derivation of ADMIN_PASSWORD. Never put either value in the browser.
# ADMIN_SESSION_SECRET=another-long-random-string
# ADMIN_SESSION_TTL_SECONDS=43200
# Vercel Cron secret for GET /api/cron/webhook-retry
# CRON_SECRET=another-long-random-string

# ─── Optional ──────────────────────────────────────────────────────────
# Fallback public base URL when no HTTP request context exists.
# NOTE: the (allowlisted) request host always WINS over this value, so a
# stale value here can no longer break customer links — but keep it accurate
# anyway. It MUST be the domain you actually serve customers on:
PUBLIC_BASE_URL=https://valmontpay.app

# How long (in hours) a dashboard-generated payment link stays valid for the
# client. Default: 720 (30 days). Tenant API checkout sessions keep their
# documented 30-minute TTL regardless of this setting.
# PAYMENT_LINK_TTL_HOURS=720

# Shorten the simulated USSD authorization delay (milliseconds).
# CHARGE_SETTLEMENT_DELAY_MS=2000

# ─── Instant Receipt Notifications (lib/notifier.js) ─────────────────────
# Every successful charge.success webhook sends an SMS/WhatsApp receipt to the
# customer (and merchant, when a phone is configured). ALL configured channels
# are used; with none set the receipt is still printed to the runtime logs.

# Generic WhatsApp provider hook — receives POST { phone, message, reference }.
# WHATSAPP_WEBHOOK_URL=https://your-whatsapp-provider.example/send

# Generic SMS provider hook — same JSON payload shape.
# SMS_WEBHOOK_URL=https://your-sms-provider.example/send

# Arkesel SMS (Ghana) — https://developers.arkesel.com
# ARKESEL_API_KEY=xxxxxxxxxxxxxxxx
# ARKESEL_SENDER_ID=VALMONT-PAY

# mNotify SMS (Ghana) — https://mnotify.com
# MNOTIFY_API_KEY=xxxxxxxxxxxxxxxx
# MNOTIFY_SENDER_ID=VALMONT-PAY

# Merchant / admin alert recipients. The customer number is taken from each
# payment's MoMo metadata automatically. With only ADMIN_EMAIL set, merchant
# alerts are logged (email-only contacts cannot receive SMS/WhatsApp).
# MERCHANT_NOTIFICATION_PHONE=0544000000
# ADMIN_NOTIFICATION_PHONE=0544000000

# ═══════════════════════════════════════════════════════════════════════
# MULTI-TENANT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
#
# Each tenant (merchant) can be configured individually with prefix-based
# environment variables. Alternatively, use TENANTS_JSON for the full config.
#
# Option A: Individual env vars (prefixed per tenant)
# ────────────────────────────────────────────────────────────────────────
# Available prefixes:
#   TENANT__<KEY>__DISPLAY_NAME      Human-readable name
#   TENANT__<KEY>__BRAND_COLOR       Brand colour hex (e.g. #f68b1e)
#   TENANT__<KEY>__CURRENCY          Currency code (GHS, NGN, etc.)
#   TENANT__<KEY>__ENVIRONMENT       Display label only: test or live (never selects Paystack keys)
#   TENANT__<KEY>__ALLOWED_DOMAINS   Comma-separated list (callback URL validation)
#   TENANT__<KEY>__SETTLEMENT_ACCOUNT Bank account info
#   TENANT__<KEY>__WEBHOOK_URL       URL to forward payment events to
#   TENANT__<KEY>__SECRET_KEY_1      API secret key for auth
#   TENANT__<KEY>__SECRET_KEY_2      Second key (during rotation)
#   TENANT__<KEY>__PUBLIC_KEY        API public key
#   TENANT__<KEY>__PAYSTACK_SECRET_KEY  Tenant's own Paystack secret key
#   TENANT__<KEY>__PAYSTACK_PUBLIC_KEY  Tenant's own Paystack public key
#
# Examples:

# Tenant: Valmont Electricals
# TENANT__VALMONT_ELECTRICALS__DISPLAY_NAME=Valmont Electricals
# TENANT__VALMONT_ELECTRICALS__BRAND_COLOR=#f68b1e
# TENANT__VALMONT_ELECTRICALS__CURRENCY=GHS
# TENANT__VALMONT_ELECTRICALS__ALLOWED_DOMAINS=valmontweb.com,valmontpay.app
# TENANT__VALMONT_ELECTRICALS__SETTLEMENT_ACCOUNT=GCB Bank - 1234567890
# TENANT__VALMONT_ELECTRICALS__WEBHOOK_URL=https://valmontelectricals.com/api/valmontpay/webhook
# TENANT__VALMONT_ELECTRICALS__SECRET_KEY_1=vme_live_secret_key_abc123
# TENANT__VALMONT_ELECTRICALS__SECRET_KEY_2=vme_live_secret_key_def456
# TENANT__VALMONT_ELECTRICALS__PUBLIC_KEY=vme_live_pub_key_abc123
# TENANT__VALMONT_ELECTRICALS__PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
# TENANT__VALMONT_ELECTRICALS__PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx

# Tenant: Valmont Web
# TENANT__VALMONTWEB__DISPLAY_NAME=Valmont Web
# TENANT__VALMONTWEB__BRAND_COLOR=#2563eb
# TENANT__VALMONTWEB__CURRENCY=GHS
# TENANT__VALMONTWEB__ALLOWED_DOMAINS=valmontweb.com
# TENANT__VALMONTWEB__WEBHOOK_URL=https://valmontweb.com/api/payments/webhook
# TENANT__VALMONTWEB__SECRET_KEY_1=vmw_live_secret_key_abc123
# TENANT__VALMONTWEB__PAYSTACK_SECRET_KEY=sk_live_yyyyyyyy

# Option B: JSON config (single env var for all tenants)
# ────────────────────────────────────────────────────────────────────────
# TENANTS_JSON=[{"key":"valmont-electricals","display_name":"Valmont Electricals","brand_color":"#f68b1e","currency":"GHS","allowed_domains":["valmontweb.com","valmontpay.app"],"settlement_account":"GCB Bank - 1234567890","webhook_url":"https://valmontweb.com/api/payments/webhook","secret_keys":["vme_live_secret_key_abc123"],"public_key":"vme_live_pub_key_abc123","paystack_secret_key":"sk_live_xxxxxxxx","paystack_public_key":"pk_live_xxxxxxxx"}]

# ═══════════════════════════════════════════════════════════════════════
# TENANT API AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════
#
# Merchants authenticate to the gateway API using their secret key as a
# Bearer token:
#
#   POST /api/transaction/initialize
#   Authorization: Bearer <secret_key>
#   Content-Type: application/json
#   {"amount": 50.00, "reference": "VM-ORDER-123", "email": "customer@example.com", "callback_url": "https://valmontweb.com/orders/thanks"}
#
# The secret key identifies the tenant and authorises the operation.
# Cross-tenant lookups return 404, not 403.
# Reference uniqueness is enforced per tenant, not globally.
