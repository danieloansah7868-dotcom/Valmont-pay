# ============================================================================
# VALMONT-PAY MERCHANT API
# ============================================================================

# Merchant display name. Shown on the checkout page and in every webhook's
# data.merchant field.
VALMONTPAY_MERCHANT_NAME=Valmont Electricals

# Settlement currency. Ghana Cedis by default; amounts everywhere in the API
# are integer MINOR units (pesewas: GH₵ 15.00 -> 1500).
VALMONTPAY_CURRENCY=GHS

# --- API keypairs ---------------------------------------------------------
# Generated automatically on first boot and printed to the log. PIN THEM HERE
# in production: a serverless filesystem is ephemeral, so without these the
# keys would be regenerated on every cold start and your merchant's integration
# would break.
#   npm run keys      # prints a fresh set ready to paste
#
# pk_* keys are browser-safe. sk_* keys are SERVER ONLY: they authorise
# initialize/verify and sign webhooks. Never ship one to a browser.
# VALMONTPAY_TEST_PUBLIC_KEY=pk_test_...
# VALMONTPAY_TEST_SECRET_KEY=sk_test_...
# VALMONTPAY_LIVE_PUBLIC_KEY=pk_live_...
# VALMONTPAY_LIVE_SECRET_KEY=sk_live_...

# --- Webhooks -------------------------------------------------------------
# Optional bootstrap values; normally set from the /merchant dashboard.
# Live URLs must be https.
# VALMONTPAY_TEST_WEBHOOK_URL=http://localhost:4000/valmontpay/webhook
# VALMONTPAY_LIVE_WEBHOOK_URL=https://valmontelectricals.com/api/valmontpay/webhook

# Per-attempt HTTP timeout, and how often the retry loop wakes up.
# VALMONTPAY_WEBHOOK_TIMEOUT_MS=15000
# VALMONTPAY_WEBHOOK_TICK_MS=15000

# --- Checkout -------------------------------------------------------------
# How long an access_code stays usable (default 1 hour).
# VALMONTPAY_ACCESS_CODE_TTL_MS=3600000

# Which mode legacy query-string links (pay.html?amount=...&ref=...) settle in.
# VALMONTPAY_LEGACY_MODE=live

# Where merchants/payments/deliveries are mirrored to disk. Point this at a
# durable volume in production.
# VALMONTPAY_DATA_DIR=./.data

# ============================================================================
# PAYSTACK (the upstream processor)
# ============================================================================

# Paystack secret key (test: sk_test_..., live: sk_live_...)
# Get yours from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL webhook HMAC secret. Paystack signs the x-paystack-signature header
# with your PAYSTACK_SECRET_KEY, so leaving this unset is fine — verification
# falls back to PAYSTACK_SECRET_KEY. Set it only to override that.
# WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project credentials — REQUIRED. Without these the dashboard cannot
# store or read transactions and will always show zero.
# Create a project at https://supabase.com and copy these from Settings → API.
SUPABASE_URL=https://xxxxxx.supabase.co
# PREFERRED. Trusted server-side writes that Row Level Security cannot reject.
# Never expose this in a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Fallback only when the transactions table has an RLS insert/select policy:
SUPABASE_ANON_KEY=eyJ...

# Optional: shorten the simulated USSD authorization delay (milliseconds).
# CHARGE_SETTLEMENT_DELAY_MS=2000

# Optional: force the public base URL used when building checkout links.
# Leave unset to derive it from the incoming request (works locally and on Vercel).
# PUBLIC_BASE_URL=https://valmont-pay.vercel.app

# Admin dashboard login (admin-login.html reads these at runtime via /config/admin.js).
# Never commit real credentials — set them here locally, and in your host's env settings on Vercel.
ADMIN_EMAIL=support@valmontpay.com
ADMIN_PASSWORD=change-me-to-a-strong-password
