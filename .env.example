# Paystack secret key (test: sk_test_..., live: sk_live_...)
# Get yours from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project credentials
# Create a project at https://supabase.com and copy these from Settings → API
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Optional: force the public base URL used when building checkout links.
# Leave unset to derive it from the incoming request (works locally and on Vercel).
# PUBLIC_BASE_URL=https://valmont-pay.vercel.app

# Admin dashboard login (admin-login.html reads these at runtime via /config/admin.js).
# Never commit real credentials — set them here locally, and in your host's env settings on Vercel.
ADMIN_EMAIL=support@valmontpay.com
ADMIN_PASSWORD=change-me-to-a-strong-password
