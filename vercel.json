{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/transaction/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/checkout/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/merchant/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/webhooks/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/initialize-payment",
      "dest": "/api/initialize-payment.js"
    },
    {
      "src": "/api/verify-payment",
      "dest": "/api/verify-payment.js"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/webhook-debug",
      "dest": "/api/webhook-debug.js"
    },
    {
      "src": "/api/test-webhook",
      "dest": "/api/test-webhook.js"
    },
    {
      "src": "/api/webhook-status",
      "dest": "/api/webhook-status.js"
    },
    {
      "src": "/api/manual-transaction",
      "dest": "/api/manual-transaction.js"
    },
    {
      "src": "/api/transactions",
      "dest": "/api/transactions.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
